{
  "name": "nasa-iod",
  "private": true,
  "version": "1.0.0",
  "description": "Textbook React 19 example: a fully commented, infinite-scrolling NASA Astronomy Picture of the Day viewer",
  "license": "MIT",
  "author": "Joshua Curry (https://github.com/lucidbeaming)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidbeaming/nasa-iod.git"
  },
  "bugs": {
    "url": "https://github.com/lucidbeaming/nasa-iod/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predeploy": "npm run build",
    "deploy": "gh-pages --dist dist --nojekyll"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "homepage": "https://lucidbeaming.github.io/nasa-iod/"
}
